{
    "name": "turkeryildirim/rule-engine",
    "description": "A small, stateless production rules engine for PHP 8.5+.",
    "keywords": [
        "rules",
        "rule engine",
        "business rules",
        "dsl"
    ],
    "homepage": "https://github.com/turkeryildirim/rule-engine",
    "license": "MIT",
    "authors": [
        {
            "name": "Türker YILDIRIM",
            "email": "me@turkeryildirim.com",
            "homepage": "https://turkeryildirim.com/"
        },
        {
            "name": "Justin Hileman",
            "email": "justin@justinhileman.info",
            "homepage": "http://justinhileman.com/",
            "role": "Author of the original Ruler library"
        }
    ],
    "support": {
        "source": "https://github.com/turkeryildirim/rule-engine"
    },
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.3",
        "turkeryildirim/phpunit-json-coverage-report": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "D6N\\RuleEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "D6N\\RuleEngine\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=2G vendor/bin/phpunit --coverage-text=build/coverage.txt --path-coverage",
            "@php bin/check-coverage.php"
        ],
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --dry-run --diff",
        "cs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@coverage"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
